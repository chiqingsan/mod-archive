<Project Sdk="Microsoft.NET.Sdk">

  <!-- 战利品品质标记 / LootRarityMarker — 逃离鸭科夫 mod
       构建：dotnet build -c Release
       产物：bin/Release/LootRarityMarker.dll
       换机器/换安装路径时只需改下面的 GameManagedDir（或用 -p:GameManagedDir=... 覆盖）。 -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LootRarityMarker</AssemblyName>
    <RootNamespace>LootRarityMarker</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- 不要生成 .deps.json / runtimeconfig：mod 由游戏 Assembly.LoadFrom 直接加载 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">d:\app\steam\steamapps\common\Escape from Duckov\Duckov_Data\Managed\</GameManagedDir>
  </PropertyGroup>

  <!-- 只引用真正用到的引擎/游戏程序集；Private=false 表示不复制到输出目录。
       EPOOutline 故意不在这里引用：路线 A（真描边）全走反射，没装/被裁掉时 mod 依然能加载。 -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- JsonUtility（读 config.json 用）在这个模块里 -->
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameManagedDir)UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Physics.OverlapSphereNonAlloc / Collider / QueryTriggerInteraction（扫描周围容器用） -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedDir)UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Item.Tags 返回 Duckov.Utilities.TagCollection，判定子弹/装备/饰品需要它 -->
  <Reference Include="TeamSoda.Duckov.Utilities">
    <HintPath>$(GameManagedDir)TeamSoda.Duckov.Utilities.dll</HintPath>
    <Private>false</Private>
  </Reference>
  <Reference Include="TeamSoda.Duckov.Core">
      <HintPath>$(GameManagedDir)TeamSoda.Duckov.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemStatsSystem">
      <HintPath>$(GameManagedDir)ItemStatsSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
